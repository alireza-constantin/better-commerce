{
  "name": "@better-commerce/sdk",
  "version": "0.1.0",
  "description": "Generated-backed Better Commerce HTTP client and contract types",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alireza-constantin/better-commerce.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/alireza-constantin/better-commerce/issues"
  },
  "homepage": "https://github.com/alireza-constantin/better-commerce#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "generate": "openapi-typescript http://127.0.0.1:3000/docs/openapi.json -o src/generated/schema.ts --immutable --alphabetize",
    "generate:check": "openapi-typescript http://127.0.0.1:3000/docs/openapi.json -o src/generated/schema.ts --immutable --alphabetize --check",
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/verify.mjs"
  },
  "dependencies": {
    "openapi-fetch": "^0.15.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
