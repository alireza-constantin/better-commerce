{
  "name": "@better-commerce/storefront-core",
  "version": "0.0.1",
  "description": "Framework-neutral Better Commerce storefront integration primitives",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@better-commerce/sdk": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
