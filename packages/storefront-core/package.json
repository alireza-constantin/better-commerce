{
  "name": "@better-commerce/storefront-core",
  "version": "0.1.0",
  "description": "Framework-neutral Better Commerce storefront integration primitives",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alireza-constantin/better-commerce.git",
    "directory": "packages/storefront-core"
  },
  "bugs": {
    "url": "https://github.com/alireza-constantin/better-commerce/issues"
  },
  "homepage": "https://github.com/alireza-constantin/better-commerce#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@better-commerce/sdk": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
