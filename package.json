{
  "name": "better-commerce",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "engines": {
    "node": ">=22.17.0",
    "pnpm": ">=11.21.0 <12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "admin:dev": "pnpm --filter @better-commerce/admin dev",
    "build": "turbo run build",
    "format": "pnpm --filter @better-commerce/api format",
    "start": "pnpm --filter @better-commerce/api start",
    "start:dev": "pnpm --filter @better-commerce/api start:dev",
    "start:debug": "pnpm --filter @better-commerce/api start:debug",
    "start:prod": "pnpm --filter @better-commerce/api start:prod",
    "lint": "turbo run lint",
    "lint:fix": "pnpm --filter @better-commerce/api lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "pnpm --filter @better-commerce/api test:watch",
    "test:cov": "pnpm --filter @better-commerce/api test:cov",
    "test:debug": "pnpm --filter @better-commerce/api test:debug",
    "test:e2e": "turbo run test:e2e",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes --remove-orphans && docker compose up -d",
    "db:logs": "docker compose logs -f postgres",
    "staff:bootstrap-owner": "pnpm --filter @better-commerce/api staff:bootstrap-owner",
    "dev:bootstrap-owner": "pnpm --filter @better-commerce/api dev:bootstrap-owner",
    "sdk:generate": "pnpm --filter @better-commerce/sdk generate",
    "sdk:check": "pnpm --filter @better-commerce/sdk generate:check",
    "release:check": "node scripts/verify-public-package-release.mjs"
  },
  "devDependencies": {
    "turbo": "2.5.4"
  }
}
